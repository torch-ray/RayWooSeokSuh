---
const pathname = Astro.url.pathname;
const isKo = pathname === '/ko' || pathname.startsWith('/ko/');
const homeHref = isKo ? '/ko/' : '/';
const writingHref = isKo ? '/ko/writing/' : '/writing/';

const isWritingActive =
  pathname === writingHref ||
  pathname.startsWith('/posts/') ||
  pathname.startsWith('/ko/posts/') ||
  pathname.startsWith('/categories/') ||
  pathname.startsWith('/ko/categories/');
const isAboutActive = pathname === '/about/';

const links = [
  { href: writingHref, label: 'Writing', active: isWritingActive },
  { href: '/about/', label: 'About', active: isAboutActive },
];
---

<header
  class="sticky top-0 z-40 border-b border-ink-hairline-light dark:border-ink-hairline backdrop-blur-xl backdrop-saturate-150 bg-ink-bg-light/70 dark:bg-ink-bg/70"
  transition:persist
>
  <nav class="mx-auto max-w-page px-6 sm:px-8 h-14 flex items-center justify-between">
    <a href={homeHref} class="font-bold tracking-tight text-[15px]" aria-label="Home">
      rs
    </a>
    <ul class="flex items-center gap-5 text-[13px]">
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            class:list={[
              'text-ink-muted-light dark:text-ink-muted hover:text-ink-fg-light dark:hover:text-ink-fg transition-colors',
              { 'text-ink-fg-light dark:text-ink-fg': l.active },
            ]}
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
