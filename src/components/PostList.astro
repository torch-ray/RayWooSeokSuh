---
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_LABELS } from '../content.config';
import { entrySlug, postUrl, type PostLang } from '../lib/posts';

interface Props {
  posts: CollectionEntry<'posts'>[];
  lang: PostLang;
}

const { posts, lang } = Astro.props;

// Group by year, descending
const byYear = posts.reduce<Record<number, CollectionEntry<'posts'>[]>>((acc, p) => {
  const year = p.data.date.getFullYear();
  (acc[year] ||= []).push(p);
  return acc;
}, {});
const years = Object.keys(byYear)
  .map(Number)
  .sort((a, b) => b - a);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', day: '2-digit' });
---

{posts.length === 0 ? (
  <p class="text-ink-muted-light dark:text-ink-muted text-[13px]">No posts yet.</p>
) : (
  years.map((year) => (
    <div class="mb-8 last:mb-0">
      <div class="text-[11px] font-medium text-ink-muted-light/70 dark:text-ink-muted/70 pb-1.5 mb-1 border-b border-ink-hairline-light dark:border-ink-hairline tabular">
        {year}
      </div>
      {byYear[year]
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
        .map((post) => (
          <a
            href={postUrl(lang, entrySlug(post))}
            class="grid grid-cols-[56px_1fr_auto] gap-5 items-baseline py-2 text-[13.5px] hover:bg-ink-hairline-light/40 dark:hover:bg-ink-hairline/40 -mx-2 px-2 rounded transition-colors"
          >
            <span class="text-[11px] text-ink-muted-light dark:text-ink-muted tabular">
              {fmt(post.data.date)}
            </span>
            <span class="tracking-tight-title">{post.data.title}</span>
            <span class="text-[10px] uppercase tracking-[0.05em] text-ink-muted-light/70 dark:text-ink-muted/70">
              {CATEGORY_LABELS[post.data.category]}
            </span>
          </a>
        ))}
    </div>
  ))
)}
