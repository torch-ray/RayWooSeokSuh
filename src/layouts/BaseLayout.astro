---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalUrl?: string;
  /** If this page has a sibling in another language, set the lang code and the path. */
  altLang?: 'en' | 'ko';
  altPath?: string;
  /** Page language (defaults to 'en' since most of the site is English). */
  lang?: 'en' | 'ko';
}

const {
  title,
  description = 'Writing on iOS, AI, CS, and the things I am figuring out along the way.',
  ogImage = '/og-default.svg',
  canonicalUrl,
  altLang,
  altPath,
  lang = 'en',
} = Astro.props;

const siteName = 'Ray Suh';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonical = canonicalUrl ?? new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
const altUrl = altPath ? new URL(altPath, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- hreflang alternates -->
    {altLang && altUrl && (
      <link rel="alternate" hreflang={altLang} href={altUrl} />
    )}
    {altLang && altUrl && (
      <link rel="alternate" hreflang={lang} href={canonical} />
    )}
    {altLang && altUrl && (
      <link rel="alternate" hreflang="x-default" href={lang === 'en' ? canonical : altUrl} />
    )}

    <link rel="alternate" type="application/rss+xml" title={siteName} href={lang === 'ko' ? '/ko/rss.xml' : '/rss.xml'} />

    <ClientRouter />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:px-3 focus:py-2 focus:bg-ink-surface-light focus:text-ink-fg-light focus:rounded"
    >
      Skip to content
    </a>
    <slot />
    <Analytics />
  </body>
</html>
