---
import { render, type CollectionEntry } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { getPostsByLang, entrySlug, siblingExists, postUrl, getReadingTimeMinutes } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPostsByLang('en');
  return posts.map((post, index) => ({
    params: { slug: entrySlug(post) },
    props: {
      post,
      next: posts[index - 1],
      prev: posts[index + 1],
    },
  }));
}

type Props = {
  post: CollectionEntry<'posts'>;
  prev?: CollectionEntry<'posts'>;
  next?: CollectionEntry<'posts'>;
};

const { post, prev, next } = Astro.props as Props;
const { Content } = await render(post);

const slug = entrySlug(post);
const readingTimeMinutes = await getReadingTimeMinutes(slug);
const hasKorean = await siblingExists(slug, 'ko');
const altPath = hasKorean ? postUrl('ko', slug) : undefined;
---

<PostLayout
  post={post}
  readingTimeMinutes={readingTimeMinutes}
  prev={prev}
  next={next}
  lang="en"
  altPath={altPath}
>
  <Content />
</PostLayout>
