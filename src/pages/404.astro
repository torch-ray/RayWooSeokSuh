---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteNav from '../components/SiteNav.astro';
---

<BaseLayout title="Not found">
  <SiteNav />
  <main id="main" class="mx-auto max-w-reading px-6 sm:px-8 pt-24 pb-20 text-center">
    <div class="text-[11px] uppercase tracking-[0.12em] font-semibold text-ink-muted-light dark:text-ink-muted mb-3">
      404
    </div>
    <h1 class="text-[34px] font-bold tracking-tight-display mb-4">Nothing here.</h1>
    <p class="text-[15px] text-ink-muted-light dark:text-ink-muted mb-8">
      The page you were looking for doesn't exist or has moved.
    </p>
    <a href="/" class="text-[14px] underline underline-offset-4">← Back to writing</a>
  </main>
</BaseLayout>
